# stanislav-peev.com - Apache/LiteSpeed config (Jump.bg / cPanel)

# ---- ModSecurity: allow AI crawlers (Jump.bg support fix) ----
# Rules 350001 + 1020 block GPTBot / OAI-SearchBot / ClaudeBot etc. with 403.
# Confirmed by Jump.bg support - remove them per domain.
<IfModule mod_security.c>
  SecRuleRemoveById 350001
  SecRuleRemoveById 1020
</IfModule>

# ---- Force www -> apex (backup to the Cloudflare rules) ----
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---- Markdown for agents ----
# Agents that ask for text/markdown via the Accept header get the .md version.
AddType text/markdown .md
AddCharset utf-8 .md

# Every page has an index.md next to its index.html. The home and services
# copies are hand-written; the rest come from .tools/build_md.py.
# If a copy is missing the rule does not fire and HTML is served.
RewriteCond %{HTTP:Accept} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/$1index.md -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.md -f
RewriteRule ^((?:[^/]+/)*)$ /$1index.md [L]

# ---- Link headers (RFC 8288): agent discovery ----
# The values are wrapped in SINGLE quotes: LiteSpeed sends \" literally when it
# is escaped inside double quotes. The relative <index.md> resolves against the
# URL of the page itself, so each page points to its own markdown copy.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Link '<https://stanislav-peev.com/llms.txt>; rel="describedby"; type="text/plain", <https://stanislav-peev.com/llms.txt>; rel="llms-txt", <index.md>; rel="alternate"; type="text/markdown", <https://stanislav-peev.com/.well-known/api-catalog>; rel="api-catalog"'
  </Files>
  # The canonical address of a markdown copy is its HTML page. Do NOT add
  # noindex here: the same file answers the canonical URL for markdown requests.
  <Files "index.md">
    Header set Link '<./>; rel="canonical"'
  </Files>
  # LiteSpeed ignores AddCharset for .md, so the charset is set explicitly
  # (the copies contain non-ASCII punctuation).
  <FilesMatch "\.md$">
    Header set Content-Type "text/markdown; charset=UTF-8"
  </FilesMatch>
  Header append Vary "Accept"
</IfModule>

# ---- .well-known: ARD catalog + Agent Skills index ----
# Static files for agents, with CORS so browser-based agents can read them.
# index.json is regenerated by .tools/build_md.py (sha256 of each SKILL.md).
AddType application/json .json
<IfModule mod_headers.c>
  <FilesMatch "^(ai-catalog\.json|index\.json|SKILL\.md)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Build tooling is not part of the site (in case it gets uploaded by hand)
RedirectMatch 404 ^/\.tools(/|$)

# ---- API catalog (RFC 9727 linkset) ----
<FilesMatch "^api-catalog$">
  ForceType application/linkset+json
</FilesMatch>

# ---- Browser caching for static assets ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
